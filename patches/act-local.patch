@@ -0,0 +1,17 @@
+"""Pure helpers for reproducible paired-view experiments."""
+
+import numpy as np
+
+
+def sample_occlusion_rectangle(height, width, area_fraction, seed):
+    if not 0 < area_fraction < 1:
+        raise ValueError('area_fraction must be between 0 and 1')
+    rng = np.random.RandomState(seed)
+    aspect = np.exp(rng.uniform(np.log(0.5), np.log(2.0)))
+    rectangle_height = min(
+        height, max(1, int(round(np.sqrt(area_fraction * height * width / aspect)))))
+    rectangle_width = min(
+        width, max(1, int(round(area_fraction * height * width / rectangle_height))))
+    y0 = int(rng.randint(0, height - rectangle_height + 1))
+    x0 = int(rng.randint(0, width - rectangle_width + 1))
+    return [y0, y0 + rectangle_height, x0, x0 + rectangle_width]
