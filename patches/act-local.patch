new file mode 100644
index 0000000..469a822
--- /dev/null
+++ b/rollout_logging.py
@@ -0,0 +1,296 @@
+"""Detailed, image-free rollout logging for ACT evaluation.
+
+The logger is intentionally independent of torch and dm_control so its file
+format and validator can be tested without a GPU runtime.  Simulation objects
+are accessed through the small ``physics.data``/``physics.model`` interface.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from typing import Any, Iterable
+
+import numpy as np
+
+
+SCHEMA_VERSION = 1
+SOCKET_GEOMS = frozenset({"socket-1", "socket-2", "socket-3", "socket-4"})
+LEFT_GRIPPER_GEOMS = frozenset({
+    "vx300s_left/10_left_gripper_finger",
+    "vx300s_left/10_right_gripper_finger",
+})
+RIGHT_GRIPPER_GEOMS = frozenset({
+    "vx300s_right/10_left_gripper_finger",
+    "vx300s_right/10_right_gripper_finger",
+})
+
+
+def _unordered_pair_matches(pair: tuple[str | None, str | None],
+                            first: set[str] | frozenset[str],
+                            second: set[str] | frozenset[str]) -> bool:
+    one, two = pair
+    return (one in first and two in second) or (two in first and one in second)
+
+
+def capture_contacts(physics: Any) -> dict[str, Any]:
+    """Copy current MuJoCo contacts without mutating simulation state."""
+    geom1_ids: list[int] = []
+    geom2_ids: list[int] = []
+    pairs: list[tuple[str | None, str | None]] = []
+    for contact_index in range(int(physics.data.ncon)):
+        contact = physics.data.contact[contact_index]
+        geom1 = int(contact.geom1)
+        geom2 = int(contact.geom2)
+        geom1_ids.append(geom1)
+        geom2_ids.append(geom2)
+        pairs.append((
+            physics.model.id2name(geom1, "geom"),
+            physics.model.id2name(geom2, "geom"),
+        ))
+
+    peg = frozenset({"red_peg"})
+    pin = frozenset({"pin"})
+    table = frozenset({"table"})
+    return {
+        "geom1_ids": np.asarray(geom1_ids, dtype=np.int32),
+        "geom2_ids": np.asarray(geom2_ids, dtype=np.int32),
+        "geom1_names": tuple(pair[0] or "" for pair in pairs),
+        "geom2_names": tuple(pair[1] or "" for pair in pairs),
+        "peg_socket": any(_unordered_pair_matches(pair, peg, SOCKET_GEOMS) for pair in pairs),
+        "peg_pin": any(_unordered_pair_matches(pair, peg, pin) for pair in pairs),
+        "right_gripper_peg": any(
+            _unordered_pair_matches(pair, RIGHT_GRIPPER_GEOMS, peg) for pair in pairs),
+        "left_gripper_socket": any(
+            _unordered_pair_matches(pair, LEFT_GRIPPER_GEOMS, SOCKET_GEOMS) for pair in pairs),
+        "peg_table": any(_unordered_pair_matches(pair, peg, table) for pair in pairs),
+        "socket_table": any(
+            _unordered_pair_matches(pair, SOCKET_GEOMS, table) for pair in pairs),
+    }
+
+
+def make_step_record(timestep: int, reward: float, policy_raw_action: np.ndarray,
+                     action: np.ndarray, observed_qpos: np.ndarray,
+                     post_step_qpos: np.ndarray, env_state: np.ndarray,
+                     physics: Any) -> dict[str, Any]:
+    """Build one post-action record for ``sim_insertion_scripted``.
+
+    ``observed_qpos`` is the policy input at t. ``post_step_qpos``, object poses,
+    reward, and contacts are from the TimeStep returned by ``env.step(action)``.
+    MuJoCo free-joint qpos layout is xyz + quaternion wxyz.
+    """
+    observed_qpos = np.asarray(observed_qpos)
+    post_step_qpos = np.asarray(post_step_qpos)
+    env_state = np.asarray(env_state)
+    if observed_qpos.shape != (14,) or post_step_qpos.shape != (14,):
+        raise ValueError("Insertion qpos must have shape (14,)")
+    if env_state.shape != (14,):
+        raise ValueError("Insertion env_state must be peg pose (7) + socket pose (7)")
+    contacts = capture_contacts(physics)
+    return {
+        "timestep": int(timestep),
+        "reward": float(reward),
+        "policy_raw_action": np.asarray(policy_raw_action).copy(),
+        "action": np.asarray(action).copy(),
+        "target_qpos": np.asarray(action).copy(),
+        "observed_qpos": observed_qpos.copy(),
+        "post_step_qpos": post_step_qpos.copy(),
+        "observed_gripper_state": observed_qpos[[6, 13]].copy(),
+        "post_step_gripper_state": post_step_qpos[[6, 13]].copy(),
+        "peg_position": env_state[:3].copy(),
+        "peg_quaternion_wxyz": env_state[3:7].copy(),
+        "socket_position": env_state[7:10].copy(),
+        "socket_quaternion_wxyz": env_state[10:14].copy(),
+        **contacts,
+    }
+
+
+def milestone_timesteps(rewards: Iterable[float], max_reward: int = 4) -> dict[str, int | None]:
+    reward_array = np.asarray(list(rewards), dtype=np.float32)
+    result: dict[str, int | None] = {}
+    for milestone in range(1, max_reward + 1):
+        reached = np.flatnonzero(reward_array >= milestone)
+        result[f"first_reward{milestone}_timestep"] = int(reached[0]) if reached.size else None
+    return result
+
+
+def records_to_arrays(records: list[dict[str, Any]]) -> dict[str, np.ndarray]:
+    if not records:
+        raise ValueError("Cannot save an empty rollout")
+    scalar_float = ("reward",)
+    scalar_int = ("timestep",)
+    vector_float = (
+        "policy_raw_action", "action", "target_qpos", "observed_qpos", "post_step_qpos",
+        "observed_gripper_state", "post_step_gripper_state", "peg_position",
+        "peg_quaternion_wxyz", "socket_position", "socket_quaternion_wxyz",
+    )
+    boolean_fields = (
+        "peg_socket", "peg_pin", "right_gripper_peg", "left_gripper_socket",
+        "peg_table", "socket_table",
+    )
+    arrays: dict[str, np.ndarray] = {}
+    for field in scalar_int:
+        arrays[field] = np.asarray([record[field] for record in records], dtype=np.int32)
+    for field in scalar_float:
+        arrays[field] = np.asarray([record[field] for record in records], dtype=np.float32)
+    for field in vector_float:
+        arrays[field] = np.stack([record[field] for record in records]).astype(np.float32)
+    for field in boolean_fields:
+        arrays[f"contact_{field}"] = np.asarray(
+            [record[field] for record in records], dtype=np.bool_)
+
+    contact_counts = np.asarray([len(record["geom1_ids"]) for record in records], dtype=np.int16)
+    max_contacts = int(contact_counts.max(initial=0))
+    geom1 = np.full((len(records), max_contacts), -1, dtype=np.int32)
+    geom2 = np.full((len(records), max_contacts), -1, dtype=np.int32)
+    max_name_length = max(
+        1,
+        *(len(name) for record in records
+          for field in ("geom1_names", "geom2_names") for name in record[field]),
+    )
+    name_dtype = f"<U{max_name_length}"
+    geom1_names = np.full((len(records), max_contacts), "", dtype=name_dtype)
+    geom2_names = np.full((len(records), max_contacts), "", dtype=name_dtype)
+    for index, record in enumerate(records):
+        count = int(contact_counts[index])
+        geom1[index, :count] = record["geom1_ids"]
+        geom2[index, :count] = record["geom2_ids"]
+        geom1_names[index, :count] = record["geom1_names"]
+        geom2_names[index, :count] = record["geom2_names"]
+    arrays["contact_count"] = contact_counts
+    arrays["contact_geom1_id"] = geom1
+    arrays["contact_geom2_id"] = geom2
+    arrays["contact_geom1_name"] = geom1_names
+    arrays["contact_geom2_name"] = geom2_names
+    return arrays
+
+
+def save_episode_logs(output_dir: str | os.PathLike[str], rollout_id: int,
+                      records: list[dict[str, Any]], metadata: dict[str, Any]) -> tuple[Path, Path]:
+    output = Path(output_dir)
+    output.mkdir(parents=True, exist_ok=True)
+    stem = f"rollout_{rollout_id:03d}"
+    timeseries_path = output / f"{stem}_timeseries.npz"
+    summary_path = output / f"{stem}_summary.json"
+    arrays = records_to_arrays(records)
+    milestones = milestone_timesteps(arrays["reward"])
+    reward3 = milestones["first_reward3_timestep"]
+    reward4 = milestones["first_reward4_timestep"]
+    summary = {
+        "schema_version": SCHEMA_VERSION,
+        **metadata,
+        "rollout_id": int(rollout_id),
+        "state_id": int(rollout_id),
+        "episode_length": len(records),
+        "episode_return": float(arrays["reward"].sum()),
+        "highest_reward": float(arrays["reward"].max()),
+        "success": bool(arrays["reward"].max() >= 4),
+        **milestones,
+        "reward3_remaining_steps": len(records) - 1 - reward3 if reward3 is not None else None,
+        "reward3_to_reward4_steps": reward4 - reward3
+        if reward3 is not None and reward4 is not None else None,
+        "timeseries_file": timeseries_path.name,
+        "array_shapes": {key: list(value.shape) for key, value in arrays.items()},
+        "array_dtypes": {key: str(value.dtype) for key, value in arrays.items()},
+        "action_semantics": {
+            "policy_raw_action": "normalized policy output before dataset-stat post-processing",
+            "action": "absolute 14-D joint/gripper command passed to env.step; identical to target_qpos",
+            "target_qpos": "alias of action, retained for explicit qpos-tracking analysis",
+            "observed_qpos": "pre-action policy observation",
+            "post_step_qpos": "observation returned after applying action",
+            "object_pose": "post-action MuJoCo free-joint qpos; xyz + quaternion wxyz",
+        },
+        "joint_layout": {
+            "left_arm": [0, 6],
+            "left_gripper": 6,
+            "right_arm": [7, 13],
+            "right_gripper": 13,
+        },
+        "contact_array_semantics": (
+            "Each row stores contact_count valid geom pairs; remaining ID entries are -1 "
+            "and remaining name entries are empty strings."
+        ),
+    }
+
+    temporary_npz = timeseries_path.with_suffix(timeseries_path.suffix + ".tmp")
+    with temporary_npz.open("wb") as stream:
+        np.savez_compressed(stream, **arrays)
+    os.replace(temporary_npz, timeseries_path)
+    temporary_json = summary_path.with_suffix(summary_path.suffix + ".tmp")
+    with temporary_json.open("w") as stream:
+        json.dump(summary, stream, indent=2, sort_keys=True)
+        stream.write("\n")
+    os.replace(temporary_json, summary_path)
+    return summary_path, timeseries_path
+
+
+def validate_episode_logs(summary_path: str | os.PathLike[str],
+                          expected_initial_state: np.ndarray | None = None) -> dict[str, Any]:
+    summary_path = Path(summary_path)
+    with summary_path.open() as stream:
+        summary = json.load(stream)
+    timeseries_path = summary_path.parent / summary["timeseries_file"]
+    with np.load(timeseries_path, allow_pickle=False) as archive:
+        arrays = {key: archive[key] for key in archive.files}
+
+    length = int(summary["episode_length"])
+    required_shapes = {
+        "timestep": (length,), "reward": (length,),
+        "policy_raw_action": (length, 14), "action": (length, 14), "target_qpos": (length, 14),
+        "observed_qpos": (length, 14), "post_step_qpos": (length, 14),
+        "observed_gripper_state": (length, 2), "post_step_gripper_state": (length, 2),
+        "peg_position": (length, 3), "peg_quaternion_wxyz": (length, 4),
+        "socket_position": (length, 3), "socket_quaternion_wxyz": (length, 4),
+        "contact_count": (length,),
+    }
+    for contact_field in (
+            "contact_peg_socket", "contact_peg_pin", "contact_right_gripper_peg",
+            "contact_left_gripper_socket", "contact_peg_table", "contact_socket_table"):
+        required_shapes[contact_field] = (length,)
+    errors: list[str] = []
+    for key, expected_shape in required_shapes.items():
+        if key not in arrays:
+            errors.append(f"missing array: {key}")
+        elif arrays[key].shape != expected_shape:
+            errors.append(f"{key} shape {arrays[key].shape} != {expected_shape}")
+    for key, value in arrays.items():
+        if np.issubdtype(value.dtype, np.number) and not np.isfinite(value).all():
+            errors.append(f"{key} contains NaN or Inf")
+    if "timestep" in arrays and not np.array_equal(arrays["timestep"], np.arange(length)):
+        errors.append("timestep is not contiguous from zero")
+    if "action" in arrays and "target_qpos" in arrays and not np.array_equal(
+            arrays["action"], arrays["target_qpos"]):
+        errors.append("action and target_qpos differ")
+    raw_contact_fields = (
+        "contact_geom1_id", "contact_geom2_id", "contact_geom1_name", "contact_geom2_name")
+    if all(field in arrays for field in raw_contact_fields):
+        raw_shapes = {arrays[field].shape for field in raw_contact_fields}
+        if len(raw_shapes) != 1 or next(iter(raw_shapes))[0] != length:
+            errors.append("raw contact arrays do not share shape (episode_length, max_contacts)")
+        elif "contact_count" in arrays:
+            max_contacts = next(iter(raw_shapes))[1]
+            if np.any(arrays["contact_count"] < 0) or np.any(
+                    arrays["contact_count"] > max_contacts):
+                errors.append("contact_count exceeds raw contact array width")
+    if "reward" in arrays:
+        if not np.isclose(arrays["reward"].sum(), summary["episode_return"]):
+            errors.append("episode_return does not match reward sum")
+        if not np.isclose(arrays["reward"].max(), summary["highest_reward"]):
+            errors.append("highest_reward does not match reward maximum")
+        expected_milestones = milestone_timesteps(arrays["reward"])
+        for key, value in expected_milestones.items():
+            if summary.get(key) != value:
+                errors.append(f"{key} does not match reward series")
+    if expected_initial_state is not None and not np.array_equal(
+            np.asarray(summary.get("initial_state")), np.asarray(expected_initial_state)):
+        errors.append("initial_state does not match expected manifest state")
+    if errors:
+        raise ValueError("; ".join(errors))
+    return {
+        "summary": str(summary_path),
+        "timeseries": str(timeseries_path),
+        "episode_length": length,
+        "compressed_bytes": timeseries_path.stat().st_size,
+        "valid": True,
+    }
