#!/bin/bash
#PBS -q Eduq
#PBS -l select=1:ncpus=4:ngpus=1:mem=64gb
#PBS -l walltime=06:00:00
#PBS -N act_pair_train

set -euo pipefail

submit_dir="${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
model_name="${MODEL_NAME:?MODEL_NAME is required}"
camera_names="${CAMERA_NAMES:?CAMERA_NAMES is required}"
job_tag="${PBS_JOBID:-manual}"
safe_job_tag="${job_tag%%.*}"
tmp_work_base="${TMP_WORK_BASE:-/tmp/${USER}_work}"
mkdir -p "$tmp_work_base"
workdir="$(mktemp -d "${tmp_work_base%/}/act_train_${model_name}_${safe_job_tag}_XXXXXX")"
result_dir="$submit_dir/results/act/paired_pilot/$model_name/train_seed0"
archive="$submit_dir/archives/datasets/act_sim_insertion_scripted_top_side_seed0_10episodes.zip"

cleanup() {
    status=$?
    trap - EXIT
    mkdir -p "$result_dir"
    cp -a "$workdir/artifacts"/. "$result_dir"/ 2>/dev/null || true
    cp -a "$workdir"/*.log "$result_dir"/ 2>/dev/null || true
    [[ "${KEEP_TMP:-0}" == 1 ]] || rm -rf -- "$workdir"
    exit "$status"
}
trap cleanup EXIT

test -s "$archive"
mkdir -p "$tmp_work_base"
source "$submit_dir/scripts/act_runtime.sh"
normalize_pbs_gpu
prepare_act_runtime
export ACT_DATA_DIR="$workdir/dataset"
export ACT_NUM_EPISODES=10
export ACT_CAMERA_NAMES="$camera_names"
mkdir -p "$ACT_DATA_DIR" "$workdir/checkpoints" "$workdir/artifacts/eval_clean"
"$act_python" "$submit_dir/scripts/extract_archive.py" \
  --archive "$archive" --destination "$ACT_DATA_DIR"
cd "$repo_stage_dir"

"$act_python" imitate_episodes.py --task_name sim_insertion_scripted \
  --ckpt_dir "$workdir/checkpoints" --policy_class ACT --kl_weight 10 \
  --chunk_size 100 --hidden_dim 512 --batch_size 8 --dim_feedforward 3200 \
  --num_epochs 2000 --lr 1e-5 --seed 0 --save_every 500 --split_seed 1 \
  --train_episode_ids 2,9,6,4,0,3,1,7 --val_episode_ids 8,5 \
  | tee "$workdir/train.log"

manifest="$submit_dir/archives/environments/sim_insertion_eval_seed1000_50.json"
for epoch in 500 1000 1500 2000; do
  output_dir="$workdir/artifacts/eval_clean/epoch_$epoch"
  mkdir -p "$output_dir"
  "$act_python" imitate_episodes.py --eval --task_name sim_insertion_scripted \
    --ckpt_dir "$workdir/checkpoints" --eval_ckpt "policy_epoch_${epoch}_seed_0.ckpt" \
    --eval_output_dir "$output_dir" --visual_condition clean --num_rollouts 50 \
    --eval_seed 1000 --eval_initial_states "$manifest" --no_save_episodes \
    --policy_class ACT --kl_weight 10 --chunk_size 100 --hidden_dim 512 \
    --batch_size 8 --dim_feedforward 3200 --num_epochs 2000 --lr 1e-5 --seed 0 \
    | tee "$workdir/eval_epoch_${epoch}.log"
done

export PILOT_WORKDIR="$workdir" MODEL_NAME="$model_name" CAMERA_NAMES="$camera_names"
"$act_python" - <<'PY_SELECT'
import json
import os
import shutil

workdir = os.environ['PILOT_WORKDIR']
rows = []
for epoch in (500, 1000, 1500, 2000):
    path = os.path.join(workdir, 'artifacts', 'eval_clean', f'epoch_{epoch}',
                        f'rollouts_policy_epoch_{epoch}_seed_0.jsonl')
    with open(path) as source:
        rollouts = [json.loads(line) for line in source if line.strip()]
    rows.append({
        'epoch': epoch,
        'successes': sum(row['success'] for row in rollouts),
        'rollouts': len(rollouts),
        'success_rate': sum(row['success'] for row in rollouts) / len(rollouts),
        'average_return': sum(row['episode_return'] for row in rollouts) / len(rollouts),
    })
selected = max(rows, key=lambda row: (row['success_rate'], row['average_return'], -row['epoch']))
summary = {
    'model': os.environ['MODEL_NAME'],
    'camera_names': os.environ['CAMERA_NAMES'].split(','),
    'training_seed': 0,
    'evaluation_seed': 1000,
    'results': rows,
    'selected_epoch': selected['epoch'],
}
artifact_dir = os.path.join(workdir, 'artifacts')
with open(os.path.join(artifact_dir, 'pilot_summary.json'), 'w') as target:
    json.dump(summary, target, indent=2, sort_keys=True)
    target.write('\n')
shutil.copy2(os.path.join(workdir, 'checkpoints',
                          f"policy_epoch_{selected['epoch']}_seed_0.ckpt"),
             os.path.join(artifact_dir, 'selected_policy.ckpt'))
for name in ('metrics.jsonl', 'split_manifest.json', 'dataset_stats.pkl'):
    shutil.copy2(os.path.join(workdir, 'checkpoints', name), artifact_dir)
PY_SELECT

echo "[INFO] paired pilot training and clean evaluation completed: $model_name ($camera_names)"
