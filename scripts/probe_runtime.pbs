#!/bin/bash
#PBS -q Eduq
#PBS -l select=1:ncpus=1:ngpus=1:mem=4gb
#PBS -l walltime=00:05:00
#PBS -N act_runtime_probe

set -uo pipefail
cd "$PBS_O_WORKDIR"

echo "HOSTNAME=$(hostname)"
sed -n '1,20p' /etc/os-release

echo "[Python]"
command -v python3 || true
python3 --version || true
command -v pip3 || true
pip3 --version || true

echo "[ROCm]"
command -v hipcc || true
hipcc --version || true
command -v rocminfo || true
rocminfo 2>/dev/null | grep -E '^[[:space:]]*(Name|Marketing Name):' | head -20 || true
rocm-smi --showproductname --showmeminfo vram --showdriverversion || true

echo "[Storage]"
df -h /tmp /home /work /work2

echo "[Relevant environment]"
env | grep -E '^(PBS|ROCM|HIP|HSA|CUDA|PATH|LD_LIBRARY_PATH)=' | sort || true
