#!/bin/bash
#PBS -q Eduq
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=05:00:00
#PBS -N act_b_test

set -euo pipefail
submit_dir="${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
view_config="${VIEW_CONFIG:?VIEW_CONFIG is required}"
demo_count="${DEMO_COUNT:?DEMO_COUNT is required}"
train_seed="${TRAIN_SEED:-0}"
selection_name="${SELECTION_NAME:-checkpoint_selection_deterministic}"
deterministic_eval="${DETERMINISTIC_EVAL:-1}"

case "$view_config" in
  single_top) camera_names="top" ;;
  single_side) camera_names="side" ;;
  multi) camera_names="top,side" ;;
  *) echo "[ERROR] invalid VIEW_CONFIG=$view_config" >&2; exit 4 ;;
esac
case "$demo_count" in 5|10|25) ;; *) echo "[ERROR] invalid DEMO_COUNT=$demo_count" >&2; exit 4 ;; esac
[[ "$train_seed" == 0 ]] || { echo "[ERROR] Phase B stage is seed 0 only" >&2; exit 4; }
case "$selection_name" in checkpoint_selection|checkpoint_selection_deterministic) ;; *) echo "[ERROR] invalid SELECTION_NAME=$selection_name" >&2; exit 4 ;; esac
case "$deterministic_eval" in 0|1) ;; *) echo "[ERROR] DETERMINISTIC_EVAL must be 0 or 1" >&2; exit 4 ;; esac

source_dir="$submit_dir/results/act/phase_b/${demo_count}demos/$view_config/train_seed${train_seed}"
selection_dir="$source_dir/$selection_name"
result_dir="$source_dir/eval_test"
selection_json="$selection_dir/validation_summary.json"
manifest="$submit_dir/archives/environments/sim_insertion_test_seed1200_100.json"
tmp_work_base="${TMP_WORK_BASE:-/tmp/${USER}_work}"
mkdir -p "$tmp_work_base"
workdir="$(mktemp -d "${tmp_work_base%/}/act_phase_b_test_${demo_count}_${view_config}_${train_seed}_XXXXXX")"

cleanup() {
  status=$?
  trap - EXIT
  mkdir -p "$result_dir"
  cp -a "$workdir/output"/. "$result_dir"/ 2>/dev/null || true
  cp -a "$workdir"/*.log "$result_dir"/ 2>/dev/null || true
  [[ "${KEEP_TMP:-0}" == 1 ]] || rm -rf -- "$workdir"
  exit "$status"
}
trap cleanup EXIT

test -e "$selection_dir/.complete"
test -s "$selection_json"
test -s "$source_dir/dataset_stats.pkl"
test -s "$manifest"
[[ ! -e "$result_dir/.complete" ]] || { echo "[ERROR] test already complete: $result_dir" >&2; exit 5; }

selected_checkpoint="$(python3 - "$selection_json" "$deterministic_eval" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
if data.get('selection_dataset') != 'fixed_validation_manifest':
    raise SystemExit('checkpoint was not selected on the fixed validation manifest')
if data.get('heldout_test_used_for_selection') is not False:
    raise SystemExit('held-out test must not be used for checkpoint selection')
if bool(data.get('deterministic_evaluation', False)) != (sys.argv[2] == '1'):
    raise SystemExit('checkpoint selection and held-out test determinism modes differ')
print(data['selected_checkpoint'])
PY
)"
case "$selected_checkpoint" in
  policy_epoch_[0-9]*_seed_0.ckpt) ;;
  *) echo "[ERROR] unsafe selected checkpoint name: $selected_checkpoint" >&2; exit 5 ;;
esac
test -s "$source_dir/$selected_checkpoint"

expected_sha256="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["selected_checkpoint_sha256"])' "$selection_json")"
actual_sha256="$(sha256sum "$source_dir/$selected_checkpoint" | awk '{print $1}')"
[[ "$actual_sha256" == "$expected_sha256" ]] || {
  echo "[ERROR] selected checkpoint SHA-256 mismatch" >&2
  exit 5
}

mkdir -p "$workdir/checkpoints" "$workdir/output"
cp "$source_dir/$selected_checkpoint" "$workdir/checkpoints/selected_policy.ckpt"
cp "$source_dir/dataset_stats.pkl" "$workdir/checkpoints/"
source "$submit_dir/scripts/act_runtime.sh"
normalize_pbs_gpu
prepare_act_runtime
export ACT_DATA_DIR="$workdir/unused" ACT_NUM_EPISODES=50 ACT_CAMERA_NAMES="$camera_names"
if [[ "$deterministic_eval" == 1 ]]; then
  export ACT_DETERMINISTIC_EVAL=1
fi
cd "$repo_stage_dir"

"$act_python" imitate_episodes.py --eval --task_name sim_insertion_scripted \
  --ckpt_dir "$workdir/checkpoints" --eval_ckpt selected_policy.ckpt \
  --eval_output_dir "$workdir/output" --visual_condition clean --num_rollouts 100 \
  --eval_seed 1200 --eval_initial_states "$manifest" --no_save_episodes \
  --save_first_n_episodes 5 --save_timeseries --model_name "$view_config" \
  --policy_class ACT --kl_weight 10 --chunk_size 100 --hidden_dim 512 --batch_size 8 \
  --dim_feedforward 3200 --num_epochs 2000 --lr 1e-5 --seed "$train_seed" \
  | tee "$workdir/test.log"

"$act_python" "$submit_dir/scripts/validate_rollout_timeseries.py" \
  "$workdir/output/timeseries" --manifest "$manifest" | tee "$workdir/timeseries_validation.log"

cd "$submit_dir"
cp "$selection_json" "$workdir/output/checkpoint_selection_summary.json"
sha256sum "$manifest" > "$workdir/output/test_manifest_sha256.txt"
sha256sum "$source_dir/$selected_checkpoint" > "$workdir/output/selected_checkpoint_sha256.txt"
sha256sum repos/act/imitate_episodes.py repos/act/rollout_logging.py \
  scripts/act_runtime.sh scripts/run_phase_b_test.pbs \
  > "$workdir/output/evaluation_source_sha256.txt"
git rev-parse HEAD > "$workdir/output/code_commit.txt"
touch "$workdir/output/.complete"
echo "[INFO] Phase B held-out test complete: demos=$demo_count model=$view_config seed=$train_seed checkpoint=$selected_checkpoint"
